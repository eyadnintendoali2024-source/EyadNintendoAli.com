[Unit]
Description=SAS School online lobby
After=network.target

[Service]
Type=simple
User=sas-online
Group=sas-online
WorkingDirectory=/opt/sas-online
ExecStart=/usr/bin/python3 /opt/sas-online/sas_online_server.py --bind 127.0.0.1 --port 8765
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/sas-online
MemoryMax=192M
CPUQuota=50%

[Install]
WantedBy=multi-user.target
